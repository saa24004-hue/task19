<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>学校図書室 貸出・返却管理</title>
  <style>
    body { font-family: sans-serif; padding: 20px; max-width: 600px; margin: 0 auto; }
    #app { display: none; }
    .record { border-bottom: 1px solid #ccc; padding: 10px 0; }
    button { padding: 8px 16px; cursor: pointer; }
    input { padding: 8px; margin-right: 10px; }
  </style>
</head>
<body>
  <h1>図書室 貸出・返却システム</h1>
  
  <!-- ログイン画面 -->
  <div id="login-screen">
    <p>Googleアカウントでログインしてください。</p>
    <button id="login-btn">Googleでログイン</button>
  </div>

  <!-- アプリ画面（ログイン後に表示） -->
  <div id="app">
    <p><span id="user-name"></span> さん、こんにちは！ <button id="logout-btn">ログアウト</button></p>
    
    <h3>記録を追加</h3>
    <input type="text" id="book-title" placeholder="本のタイトル" required>
    <select id="action-type">
      <option value="貸出">貸出</option>
      <option value="返却">返却</option>
    </select>
    <button id="submit-btn">記録する</button>

    <h3>履歴</h3>
    <div id="records-list"></div>
  </div>

  <!-- Firebase SDK の読み込み -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.5.0/firebase-app.js";
    import { getAuth, signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.5.0/firebase-auth.js";
    import { getFirestore, collection, addDoc, onSnapshot, query, orderBy, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.5.0/firebase-firestore.js";

    rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
    const firebaseConfig = {
      apiKey: "YOUR_API_KEY",
      authDomain: "YOUR_PROJECT_ID.firebaseapp.com",
      projectId: "YOUR_PROJECT_ID",
      storageBucket: "YOUR_PROJECT_ID.appspot.com",
      messagingSenderId: "YOUR_SENDER_ID",
      appId: "YOUR_APP_ID"
    };

    // Firebaseの初期化
    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getFirestore(app);
    const provider = new GoogleAuthProvider();

    // UI要素の取得
    const loginScreen = document.getElementById('login-screen');
    const appScreen = document.getElementById('app');
    const userNameDisplay = document.getElementById('user-name');
    const recordsList = document.getElementById('records-list');
    const bookTitleInput = document.getElementById('book-title');
    const actionTypeSelect = document.getElementById('action-type');

    // ログイン状態の監視
    onAuthStateChanged(auth, (user) => {
      if (user) {
        loginScreen.style.display = 'none';
        appScreen.style.display = 'block';
        userNameDisplay.textContent = user.displayName;
        loadRecords(); // データを読み込む
      } else {
        loginScreen.style.display = 'block';
        appScreen.style.display = 'none';
      }
    });

    // ログイン処理
    document.getElementById('login-btn').addEventListener('click', () => {
      signInWithPopup(auth, provider).catch(error => console.error(error));
    });

    // ログアウト処理
    document.getElementById('logout-btn').addEventListener('click', () => {
      signOut(auth).catch(error => console.error(error));
    });

    // 記録の追加処理
    document.getElementById('submit-btn').addEventListener('click', async () => {
      const title = bookTitleInput.value;
      const action = actionTypeSelect.value;
      if (!title) return alert("本のタイトルを入力してください");

      try {
        await addDoc(collection(db, "library_records"), {
          bookTitle: title,
          action: action,
          userName: auth.currentUser.displayName,
          userEmail: auth.currentUser.email,
          createdAt: serverTimestamp()
        });
        bookTitleInput.value = ''; // 入力欄をクリア
      } catch (error) {
        console.error("エラー:", error);
        alert("記録に失敗しました。ルールの設定を確認してください。");
      }
    });

    // データの読み込みと表示（リアルタイム）
    function loadRecords() {
      const q = query(collection(db, "library_records"), orderBy("createdAt", "desc"));
      onSnapshot(q, (snapshot) => {
        recordsList.innerHTML = '';
        snapshot.forEach((doc) => {
          const data = doc.data();
          const date = data.createdAt ? data.createdAt.toDate().toLocaleString('ja-JP') : '記録中...';
          const div = document.createElement('div');
          div.className = 'record';
          div.textContent = `[${date}] ${data.userName}さん が「${data.bookTitle}」を ${data.action} しました。`;
          recordsList.appendChild(div);
        });
      });
    }
  </script>
</body>
</html>
